<bar protocol-version="0"
     id="codex-resets"
     title="Codex Resets"
     version="0.1.0"
     category="ai"
     refresh="2m"
     placements="menubar"
     open-mode="flyout"
     description="追踪 OpenAI Codex 额度重置公告，并在新公告时提醒。"
     homepage="https://codex-resets.com"
     icon="data:image/svg+xml;base64,">

  <permissions>
    <network origin="https://codex-resets.com" />
  </permissions>

  <inputs>
    <input name="notifyEnabled"
           type="bool"
           default="true"
           label="新重置提醒"
           help="检测到新的额度重置公告时发送系统通知。" />
  </inputs>

  <docs><![CDATA[数据来自 codex-resets.com 的公开 API（监听 @thsottiaux 的推文整理 Codex 额度重置公告）。首次加载只记录最新公告，之后每 2 分钟检查一次，出现新公告时可通过「新重置提醒」开关控制系统通知。面板固定展示最近 3 条公告，完整归档请点击「在官网查看全部」跳转 codex-resets.com。]]></docs>

