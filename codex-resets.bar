};
var W = 380;
var H = 600;
var API = "https://codex-resets.com/api/v1";
var SHOT_HEIGHT = 722;
var FEED_COUNT = 3;

// src/state.js
var state = {
  status: null,
  // /status 解析结果
  resets: [],
  // /resets 列表（时间倒序）
  error: "",
  // 最近一次请求错误（失败时保留旧数据）
  lastLoadedAt: 0,
  // 最近一次成功加载时间戳
  seenId: "",
  // 提醒机：已见过的最新公告 id
  tzMode: "local"
  // 时区显示："local" | "utc"
};
var TZ_KEY = "tzMode";
try {
  if (globalThis.localStorage && globalThis.localStorage.getItem(TZ_KEY) === "utc") {
    state.tzMode = "utc";
  }
} catch {
}
function setTzMode(value) {
  state.tzMode = value;
  try {
    globalThis.localStorage && globalThis.localStorage.setItem(TZ_KEY, value);
  } catch {
  }
}
var inflight = null;
var loading = () => !!inflight;
async function load(env) {
  const [st, rs] = await Promise.all([
    getJSON(API + "/status"),
    getJSON(API + "/resets?limit=100")
  ]);
  const next = readStatus(st);
  const list = Array.isArray(rs && rs.data) ? rs.data.map(readReset).filter(Boolean) : [];
  state.status = next;
  state.resets = list;
  state.error = "";
  state.lastLoadedAt = Date.now();
  const latest = next.latest;
  if (latest && latest.id) {
    if (state.seenId && state.seenId !== latest.id) {
      const on = !(env && env.inputs && env.inputs.notifyEnabled === false);
      if (on) {
        const summary = latest.text.length > 120 ? latest.text.slice(0, 117) + "\u2026" : latest.text;
        const n = new Notification(t("\u901A\u77E5\u6807\u9898"), { body: summary || t("\u901A\u77E5\u515C\u5E95"), tag: "reset" });
        if (latest.url) n.onclick = () => $metrix.openURL(latest.url);
        $metrix.toast(t("\u901A\u77E5\u6807\u9898"));
      }
    }
    state.seenId = latest.id;
  }
}
async function loadFromCache(e) {
  state.error = String(e && e.message || e);
  if (state.status || state.resets.length) return;
  const c = globalThis.caches && caches.default;
  if (!c) return;
  try {
    const [st, rs] = await Promise.all([
      c.match(API + "/status"),
      c.match(API + "/resets?limit=100")
    ]);
    const savedAt = st && st.headers ? Number(st.headers.get("x-saved-at")) || 0 : 0;
    const next = st ? readStatus(await st.json()) : null;
    const rawList = rs ? await rs.json() : null;
    const list = Array.isArray(rawList && rawList.data) ? rawList.data.map(readReset).filter(Boolean) : [];
    if (!next && !list.length) return;
    state.status = next;
    state.resets = list;
    state.lastLoadedAt = savedAt || state.lastLoadedAt;
  } catch {
  }
}
function refresh(env) {
  if (inflight) return inflight;
  $metrix.invalidate();
  inflight = load(env).catch(loadFromCache).finally(() => {
    inflight = null;
    $metrix.invalidate();
  });
  return inflight;
}
var launchRefresh = () => {
  void refresh();
};
function phase() {
  if (state.status || state.resets.length) return "ready";
  return state.error ? "problem" : "loading";
}
var sharing = false;
var isSharing = () => sharing;
function shareShot() {
  if (sharing) return;
  if (typeof ($metrix.panel && $metrix.panel.screenshot) !== "function") {
    $metrix.notify("Codex Resets", t("\u622A\u56FE\u4E0D\u652F\u6301"));
    return;
  }
  sharing = true;
  $metrix.invalidate();
  setTimeout(() => {
    (async () => {
      try {
        const blob = await $metrix.panel.screenshot({ scale: 2, height: SHOT_HEIGHT });
        await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
        $metrix.notify("Codex Resets", t("\u622A\u56FE\u6210\u529F"));
      } catch (e) {
        $metrix.notify("Codex Resets", t("\u622A\u56FE\u5931\u8D25", String(e && e.message || e)));
      } finally {
        sharing = false;
        $metrix.invalidate();
      }
    })();
  }, 1500);
}

