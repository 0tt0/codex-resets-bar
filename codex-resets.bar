    tile(C.SUN, t("\u7EDF\u8BA1\u6B21\u6570"), s && s.total != null ? t("\u7EDF\u8BA1\u6B21\u6570\u503C", s.total) : "\u2014"),
    tile(C.ROSE, t("\u7EDF\u8BA1\u95F4\u9694"), s && s.avgIntervalDays != null ? t("\u7EDF\u8BA1\u95F4\u9694\u503C", s.avgIntervalDays) : "\u2014"),
    tile(C.SKY, t("\u7EDF\u8BA1\u8FD1\u671F"), t("\u7EDF\u8BA1\u8FD1\u671F\u503C", recentCount(30)))
  );
