function Body() {
  const p = phase();
  if (p === "problem") return Problem();
  if (p === "loading") return Loading();
  return el(
    "Column",
    { gap: 12, padding: [14, 16, 10, 16], fillWidth: true },
    state.error ? ErrorBanner() : null,
    Header(),
    Hero(),
    Watch(),
    Stats(),
    Heatmap(),
    Feed(),
    Footer()
  );
}
function trayTree() {
  const s = state.status;
  const latest = s && s.latest;
  let days = s && s.daysSinceLast != null ? s.daysSinceLast : null;
  if (days == null) days = daysSince(s && s.lastResetAt || latest && latest.at || "");
  const title = days != null ? fmtDays(days) + "d" : state.error ? "!" : "\u2014";
  const tip = latest && latest.text ? "Codex Resets \xB7 " + t("\u6258\u76D8\u6700\u8FD1\u91CD\u7F6E") + relTime(latest.at) + " \xB7 " + latest.text.slice(0, 60) : "Codex Resets";
  const tray = {
    icon: CODEX_ICON,
    iconTemplate: true,
    title,
    tooltip: tip,
    menu: [
      { label: t("\u83DC\u5355\u6253\u5F00\u5B98\u7F51"), onClick: openSite }
    ]
  };
  if (!state.status && !state.resets.length && state.error) tray.error = state.error;
  return tray;
}
function panelTree() {
  const inner = isSharing() ? el("Column", { fillWidth: true, height: SHOT_HEIGHT, background: C.PAPER }, Body()) : el("Scroll", { grow: 1, basis: 0, fillWidth: true }, Body());
  return el("Column", {
    width: W,
    height: H,
    fontSize: 13,
    textColor: C.INK,
    background: C.PAPER,
    shortcuts: { "CmdOrCtrl+R": launchRefresh }
  }, inner);
}

// src/main.js
var main_default = {
  // 定时刷新（refresh="2m"）；env.inputs.notifyEnabled 控制新公告提醒
  async scheduled(env) {
    await refresh(env);
  },
  render() {
    return { tray: trayTree(), panel: panelTree() };
  },
  event(name, payload) {
    if (name === "lifecycle" && payload && payload.type === "expand" && !loading() && Date.now() - state.lastLoadedAt > 12e4) launchRefresh();
  }
};
export {
  main_default as default
};
