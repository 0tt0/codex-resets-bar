<bar protocol-version="0"
     id="codex-resets"
     title="Codex Resets"
     version="0.4.0"
     license="Apache-2.0"
     category="ai"
     refresh="2m"
     placements="menubar"
     open-mode="flyout"
     description="追踪 Codex 额度重置公告，新公告即提醒"
     homepage="https://codex-resets.com"
     icon="data:image/svg+xml;base64,">

  <locale lang="en" description="Track Codex quota resets and get notified when a new announcement drops." />

  <permissions>
    <network origin="https://codex-resets.com" />
  </permissions>

  <inputs>
    <input name="notifyEnabled"
           type="bool"
           default="true"
           label="新重置提醒"
           help="检测到新的额度重置公告时发送系统通知。">
      <locale lang="en" label="New reset alerts" help="Send a system notification when a new reset announcement appears." />
    </input>
  </inputs>

  <docs><![CDATA[数据来自 codex-resets.com 公开 API，每 2 分钟检查一次，出现新公告时发系统通知（可在设置关闭）。面板展示最近 3 条公告与近 4 个月重置日历，完整归档见官网。界面语言跟随 Metrix.Bar 显示语言。]]><locale lang="en"><![CDATA[Data comes from the public codex-resets.com API and is checked every 2 minutes; a system notification fires when a new announcement appears (can be turned off in settings). The panel shows the latest 3 announcements and a four-month reset calendar; see codex-resets.com for the full archive. The interface language follows your Metrix.Bar display language.]]></locale></docs>

  <script apis="screenshot clipboard shell notification caches"><![CDATA[
// src/time.js
function relTime(iso) {
  const t2 = Date.parse(iso || "");
  if (!Number.isFinite(t2)) return "\u2014";
  let ms = Date.now() - t2;
  const future = ms < 0;
  ms = Math.abs(ms);
  const min = Math.floor(ms / 6e4);
  if (LANG === "zh") {
    const suffix = future ? "\u540E" : "\u524D";
    if (min < 1) return "\u521A\u521A";
    if (min < 60) return min + " \u5206\u949F" + suffix;
    const hr2 = Math.floor(min / 60);
    if (hr2 < 24) return hr2 + " \u5C0F\u65F6" + suffix;
    const day2 = Math.floor(hr2 / 24);
    if (day2 < 30) return day2 + " \u5929" + suffix;
    const mon2 = Math.floor(day2 / 30);
    if (mon2 < 12) return mon2 + " \u4E2A\u6708" + suffix;
    return Math.floor(mon2 / 12) + " \u5E74" + suffix;
  }
  if (min < 1) return "just now";
  const hr = Math.floor(min / 60);
  const day = Math.floor(hr / 24);
  const mon = Math.floor(day / 30);
  let n, unit;
  if (min < 60) {
    n = min;
    unit = "m";
  } else if (hr < 24) {
    n = hr;
    unit = "h";
  } else if (day < 30) {
    n = day;
    unit = "d";
  } else if (mon < 12) {
    n = mon;
    unit = "mo";
  } else {
    n = Math.floor(mon / 12);
    unit = "y";
  }
  return future ? "in " + n + unit : n + unit + " ago";
}
function absTime(iso, utc) {
  const t2 = Date.parse(iso || "");
  if (!Number.isFinite(t2)) return "\u2014";
  const d = new Date(t2);
  const p = (n) => String(n).padStart(2, "0");
  const date = utc ? d.getUTCFullYear() + "-" + p(d.getUTCMonth() + 1) + "-" + p(d.getUTCDate()) : d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate());
  const time = utc ? p(d.getUTCHours()) + ":" + p(d.getUTCMinutes()) : p(d.getHours()) + ":" + p(d.getMinutes());
  return date + " " + time + (utc ? " UTC" : "");
}
