// src/ui.js
var el = (type, props, ...children) => {
  const kids = children.flat(8).filter((c) => c !== null && c !== void 0 && c !== false).map((c) => typeof c === "string" || typeof c === "number" ? String(c) : c).filter((c) => c != null);
