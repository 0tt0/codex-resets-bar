}
function recentCount(days) {
  const cut = Date.now() - days * 864e5;
  let n = 0;
  for (const r of state.resets) {
    const t2 = Date.parse(r.at);
    if (Number.isFinite(t2) && t2 >= cut) n++;
  }
  return n;
}
function Stats() {
  const s = state.status;
  const tile = (bg, label, value) => el("Box", {
    background: bg,
    border: [1, C.HAIR],
    radius: 10,
    padding: [10, 10],
    grow: 1,
    basis: 0
